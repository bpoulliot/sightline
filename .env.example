# Copy to .env and fill in. .env is gitignored; never commit a real value.

# --- Canvas -----------------------------------------------------------------
# Both of these are the FALLBACK. Normally the base URL and token are entered on
# the Settings screen and held encrypted in the run store; these are what a
# container uses when nothing has been entered yet.
#
# Base URL of your Canvas instance. Treated as a secret: it identifies the
# institution, so it never appears in docs, tests, fixtures or examples.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_API_TOKEN=0000~replace_me_with_a_real_token

# Whether Sightline asks Canvas to build a fresh content export of each course
# it reviews. On by default: the checks that read a document's own bytes have
# nothing to read without one. It does not modify course content — an export
# artifact appears in the course's export list. Set it to false and Sightline
# reads an export the course already has instead, and every request it makes to
# Canvas is a read. The Settings screen wins over this value.
# SIGHTLINE_REQUEST_CONTENT_EXPORT=true

# Whether the policy-link check may request the addresses a course links to, to
# find out whether they still exist. OFF by default. It is the only traffic
# Sightline makes outside Canvas, a batch review would make it in bulk, and a
# check that quietly becomes a few hundred outbound requests is one a network
# team switches off rather than you. With it off the check still reports which
# policy links are present; it claims nothing about where they go. A request
# that fails is reported as UNKNOWN, never as a broken link.
# SIGHTLINE_RESOLVE_LINKS=false

# --- Credential encryption --------------------------------------------------
# Key for credentials entered on the Settings screen. Leave it unset and
# Sightline manages a key file at <data root>/secrets/credentials.key, mode
# 0600. Set it to keep the key out of the data volume entirely — which is the
# point, since a key sitting beside the ciphertext protects a copied database
# but not a copied data root.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# SIGHTLINE_SECRET_KEY=

# --- Sign-in (off by default) ----------------------------------------------
# Sign-in mode: every request must come through an auth proxy that adds the
# shared secret below and the signed-in person's identity headers, or it is
# refused with 401. Leave it off for the single-user local tool. The secret is
# environment-only; generate one with
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SIGHTLINE_SIGNIN=false
# SIGHTLINE_SIGNIN_SECRET=
#
# Header names. The defaults are Authentik's proxy outpost headers, plus the
# secret header the proxy is configured to add. For oauth2-proxy in front of
# Entra ID: X-Forwarded-User, X-Forwarded-Preferred-Username,
# X-Forwarded-Groups and a separator of ",".
# SIGHTLINE_SIGNIN_SECRET_HEADER=X-Sightline-Proxy-Secret
# SIGHTLINE_SIGNIN_SUBJECT_HEADER=X-authentik-uid
# SIGHTLINE_SIGNIN_NAME_HEADER=X-authentik-name
# SIGHTLINE_SIGNIN_GROUPS_HEADER=X-authentik-groups
# SIGHTLINE_SIGNIN_GROUPS_SEPARATOR=|
#
# The group whose members are admins: they see every person's runs and alone
# change the instance settings (Canvas base URL, export preference, model host
# and model). Matched exactly against the groups header: a group name from
# Authentik, a group object id from Entra ID. Unset, nobody is an admin.
# SIGHTLINE_SIGNIN_ADMIN_GROUP=

# --- Working data -----------------------------------------------------------
# Root for course exports, caches, run state and generated reports. Everything
# under it is gitignored. Point it outside the repo if you prefer.
SIGHTLINE_DATA_DIR=./data

# --- Effort model -----------------------------------------------------------
# A YAML file overriding entries of the per-defect cost table, same shape as
# src/sightline/rubric/costs.yaml. Its entries replace the shipped ones one by
# one; anything it does not name keeps the shipped value. Every shipped number
# is an UNCALIBRATED estimate, and a cost of zero is refused. Unset = shipped.
# SIGHTLINE_EFFORT_COSTS=/path/to/costs.yaml

# --- Local model host -------------------------------------------------------
# The root of an Ollama server. This is the fallback: the endpoint is normally
# set on the Settings screen, which wins over this value.
OLLAMA_BASE_URL=http://ollama.example.lan:11434

# Concurrent model calls. Default 1, and leaving it there is the safe choice:
# an earlier local-AI pipeline on this network died from 48-way concurrency
# against capacity that could not sustain it, and it died silently.
OLLAMA_CONCURRENCY=1

# Context window pinned on every call. NOT a quality setting. Without a pin,
# Ollama sizes its allocation from whatever window a model declares, and a 2 GB
# model that declares 131,072 tokens is then refused for wanting 52 GiB.
OLLAMA_NUM_CTX=8192

# --- Optional escalation (OpenAI-compatible) --------------------------------
# SIGHTLINE_ESCALATION_BASE_URL=
# SIGHTLINE_ESCALATION_API_KEY=
