# Copy to .env and fill in. .env is gitignored; never commit a real value.

# --- Canvas -----------------------------------------------------------------
# Both of these are the FALLBACK. Normally the base URL and token are entered on
# the Settings screen and held encrypted in the run store; these are what a
# container uses when nothing has been entered yet.
#
# Base URL of your Canvas instance. Treated as a secret: it identifies the
# institution, so it never appears in docs, tests, fixtures or examples.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_API_TOKEN=0000~replace_me_with_a_real_token

# --- Credential encryption --------------------------------------------------
# Key for credentials entered on the Settings screen. Leave it unset and
# Sightline manages a key file at <data root>/secrets/credentials.key, mode
# 0600. Set it to keep the key out of the data volume entirely — which is the
# point, since a key sitting beside the ciphertext protects a copied database
# but not a copied data root.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# SIGHTLINE_SECRET_KEY=

# --- Working data -----------------------------------------------------------
# Root for course exports, caches, run state and generated reports. Everything
# under it is gitignored. Point it outside the repo if you prefer.
SIGHTLINE_DATA_DIR=./data

# --- Local model host -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama.example.lan:11434
OLLAMA_CONCURRENCY=1

# --- Optional escalation (OpenAI-compatible) --------------------------------
# SIGHTLINE_ESCALATION_BASE_URL=
# SIGHTLINE_ESCALATION_API_KEY=
