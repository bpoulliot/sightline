  "interactions": [
    {
      "method": "POST",
      "path": "/api/v1/courses/4416/content_exports",
      "form": {
        "export_type": "common_cartridge"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "json": {
          "id": 8803,
          "workflow_state": "created",
          "export_type": "common_cartridge",
          "created_at": "2026-02-01T09:00:00Z",
          "progress": 0
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/courses/4416/content_exports/8803",
      "responses": [
        {
          "status": 200,
          "headers": {
            "Content-Type": "application/json; charset=utf-8"
          },
          "json": {
            "id": 8803,
            "workflow_state": "quiesced",
            "export_type": "common_cartridge",
            "created_at": "2026-02-01T09:00:00Z",
            "progress": null
          }
        }
      ]
    }
  ]
